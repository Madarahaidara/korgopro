# ============================================================================
# Korgo Pro (desktop) — Configuration de connexion PostgreSQL / Supabase
#
# Copiez ce fichier en `.env` et renseignez vos valeurs.
# ATTENTION : `.env` contient des secrets → il est déjà ignoré par git.
#
# Récupérez la chaîne de connexion dans le dashboard Supabase :
#   Project Settings -> Database -> Connection string -> SQLAlchemy
#
# Utilisez le PORT 5432 (session pooling) pour l'app desktop SQLAlchemy.
# Le port 6543 (transaction pooling / PgBouncer) interdit les statements
# préparés et est réservé aux API / edge functions.
# ============================================================================

# --- PostgreSQL / Supabase ------------------------------------------------
# Format (utilisateur "postgres") :
#   postgresql+psycopg2://postgres:<MOT_DE_PASSE>@db.<REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:CHANGER_MOT_DE_PASSE@db.CHANGER_REF.supabase.co:5432/postgres

# Mode SSL (Supabase impose au moins "require")
# DB_SSLMODE=require

# Paramètres du pool de connexions (optimisés pour l'app desktop)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# Enregistre les requêtes SQL dans la console (ne mettre à "1" qu'en debug)
# DATABASE_ECHO=0

# --- Pour garder un repli SQLite en développement / tests -----------------
# Ne rien renseigner pour utilisateur postgresql, ou mettre :
#   DATABASE_URL=sqlite:///korgo_pro.db