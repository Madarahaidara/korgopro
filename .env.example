# Exemple de fichier .env pour Korgo Pro
# Copiez ce fichier en .env et adaptez les valeurs avant de lancer l'application

# URL de la base de données SQLAlchemy (ex: sqlite file, PostgreSQL, etc.)
# Par défaut l'application utilisera sqlite:///korgo_pro.db
KORGO_DB_URL=sqlite:///korgo_pro.db

# Clé secrète pour signer/hasher si nécessaire (changer en production)
SECRET_KEY=change_me_to_a_random_value

# Environnement (development | production)
PYTHON_ENV=development

# Niveau de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Exemple : adresse email admin (optionnel)
ADMIN_EMAIL=admin@example.com

# Autres variables utiles
# PATH_TO_LOGS=./logs
# ENABLE_METRICS=false
