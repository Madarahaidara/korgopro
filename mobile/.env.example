# ============================================================================
# Korgo Pro Terrain (mobile) — Connexion Supabase
#
# Copiez ce fichier en `.env` puis renseignez les valeurs du projet Supabase
# (Project Settings -> API). Ce sont EXACTEMENT les mêmes valeurs que celles
# utilisées par la version web (web/.env) : les deux clients écrivent dans la
# même base, avec la même clé publique.
#
#   > copy .env.example .env
#
# IMPORTANT : les variables doivent commencer par EXPO_PUBLIC_ pour être
# embarquées dans le bundle par Expo. La clé `anon`/publishable est publique
# par nature (les RLS s'appliquent) — n'y mettez JAMAIS de clé service_role.
# ============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://<REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<cle_publique>
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<cle_publique>
EXPO_PUBLIC_SUPABASE_SCHEMA=public

# Devise affichée (identique aux paramètres société des apps desktop/web).
# Le serveur reçoit cette valeur à chaque vente (colonne sales.currency).
EXPO_PUBLIC_CURRENCY=FCFA

# Taux de TVA appliqué par défaut dans la caisse (0 = pas de TVA).
EXPO_PUBLIC_TAX_RATE=0
