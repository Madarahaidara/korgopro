# ============================================================================
# Korgo Pro Web — Connexion Supabase
#
# Copiez ce fichier en `.env` puis renseignez les valeurs récupérées dans
# le dashboard Supabase :
#   Project Settings -> API -> Project URL  +  API Keys (publishable / anon)
#
#   > copy .env.example .env
#
# SANS ce fichier, l'application démarre en mode local (localStorage) :
# mode démo autonome, aucune erreur bloquante.
#
# ATTENTION : `.env` contient une clé publique mais reste propre à votre
# projet -> il est ignoré par git (voir .gitignore).
# ============================================================================

# URL du projet Supabase (obligatoire)
VITE_SUPABASE_URL=https://<REF>.supabase.co

# Clé publique : « publishable key » (nouvelles versions) ou « anon key »
# (versions historiques). Les deux noms sont acceptés.
VITE_SUPABASE_ANON_KEY=<cle_publique>
# VITE_SUPABASE_PUBLISHABLE_KEY=<cle_publique>

# Schéma PostgreSQL exposé à l'API REST (public par défaut)
VITE_SUPABASE_SCHEMA=public