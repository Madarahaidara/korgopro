/* ===== THÈME BLEU MARINE (variables utilisées: {{PRIMARY}}, {{PRIMARY_DARK}}, {{PRIMARY_LIGHT}}, {{BG}}, {{SURFACE}}, {{SURFACE_ALT}}, {{BORDER}}, {{TEXT}}, {{MUTED}}, {{ACCENT}}, {{MUTED_LIGHT}}, {{MUTED_LIGHT2}}) ===== */
QMainWindow {
    background-color: {{BG}};
}

/* ===== HEADER ===== */
#Header {
    background-color: {{SURFACE}};
    border-bottom: 1px solid {{BORDER}};
}

#Logo {
    font-size: 24px;
    font-weight: 800;
    color: {{PRIMARY}};
    padding: 5px;
}

#PageTitle {
    font-size: 18px;
    font-weight: 600;
    color: {{TEXT}};
    padding: 5px 10px;
}

#UserInfo {
    font-size: 14px;
    color: {{MUTED}};
    padding: 5px 10px;
}

#LogoutButton {
    background-color: {{PRIMARY_LIGHT}};
    color: {{PRIMARY}};
    border: 1px solid {{PRIMARY}};
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 14px;
}

#LogoutButton:hover {
    background-color: {{PRIMARY_LIGHT}};
    border-color: {{PRIMARY}};
}

#LogoutButton:pressed {
    background-color: {{PRIMARY}};
}

/* ===== MENU LATÉRAL ===== */
#SideMenu {
    background-color: {{PRIMARY}};
    border-right: 1px solid {{PRIMARY}};
}

#ToggleMenu {
    background-color: transparent;
    color: {{SURFACE}};
    border: 1px solid {{PRIMARY}};
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}

#ToggleMenu:hover {
    background-color: {{PRIMARY}};
}

#ToggleMenu:pressed {
    background-color: {{PRIMARY_DARK}};
}

/* Boutons du menu (état normal) */
#SideMenu QPushButton {
    background-color: transparent;
    color: {{PRIMARY_LIGHT}};
    border: 1px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 12px;
    font-size: 14px;
    font-weight: 500;
}

#SideMenu QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: {{SURFACE}};
    border-color: {{ACCENT}};
}

#SideMenu QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

#SideMenu QPushButton:checked {
    background-color: {{PRIMARY_DARK}};
    color: {{SURFACE}};
    border-color: {{ACCENT}};
}

/* Boutons spécifiques */
#btn_dashboard, #btn_sale, #btn_stock, #btn_admin {
    background-color: transparent;
}

/* ===== CONTENU PRINCIPAL ===== */
QStackedWidget {
    background-color: {{SURFACE}};
    border-left: 1px solid {{BORDER}};
}

/* ===== WIDGETS GÉNÉRAUX ===== */
QWidget {
    font-family: 'Segoe UI', 'Arial', sans-serif;
}

QLabel {
    color: {{TEXT}};
    font-size: 14px;
}

QPushButton {
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton:disabled {
    background-color: {{BORDER}};
    color: {{MUTED_LIGHT2}};
    border-color: {{MUTED_LIGHT}};
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    border: none;
    background-color: {{SURFACE_ALT}};
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: {{MUTED_LIGHT}};
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{MUTED_LIGHT2}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: {{SURFACE_ALT}};
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: {{MUTED_LIGHT}};
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{MUTED_LIGHT2}};
}

/* ===== BORDURES ET SÉPARATEURS ===== */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid {{MUTED_LIGHT}};
    border-radius: 6px;
    padding: 8px;
    background-color: {{SURFACE}};
    selection-background-color: {{PRIMARY}};
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: {{PRIMARY}};
    outline: none;
}

/* ===== TABLES ===== */
QTableView, QTableWidget {
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    background-color: {{SURFACE}};
    alternate-background-color: {{BG}};
    selection-background-color: {{PRIMARY_LIGHT}};
    selection-color: {{PRIMARY}};
    gridline-color: {{BORDER}};
}

QHeaderView::section {
    background-color: {{SURFACE_ALT}};
    color: {{MUTED}};
    font-weight: 600;
    padding: 10px;
    border: none;
    border-right: 1px solid {{BORDER}};
    border-bottom: 1px solid {{BORDER}};
}

/* ===== GROUP BOX ===== */
QGroupBox {
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: 600;
    color: {{PRIMARY}};
    background-color: {{SURFACE}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 10px;
}

/* ===== CHECKBOX & RADIO BUTTON ===== */
QCheckBox, QRadioButton {
    color: {{TEXT}};
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked {
    background-color: {{PRIMARY}};
    border: 2px solid {{PRIMARY}};
    border-radius: 3px;
}

QRadioButton::indicator:checked {
    background-color: {{PRIMARY}};
    border: 2px solid {{PRIMARY}};
    border-radius: 8px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    border: 1px solid {{MUTED_LIGHT}};
    border-radius: 4px;
    background-color: {{SURFACE_ALT}};
    text-align: center;
    color: {{MUTED}};
}

QProgressBar::chunk {
    background-color: {{PRIMARY}};
    border-radius: 3px;
}

/* ===== LISTES ===== */
QListWidget {
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    background-color: {{SURFACE}};
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid {{SURFACE_ALT}};
}

QListWidget::item:selected {
    background-color: {{PRIMARY_LIGHT}};
    color: {{PRIMARY}};
}

/* ===== ONGLETS ===== */
QTabWidget::pane {
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    background-color: {{SURFACE}};
}

QTabBar::tab {
    background-color: {{SURFACE_ALT}};
    color: {{MUTED}};
    padding: 8px 16px;
    margin-right: 2px;
    border: 1px solid {{BORDER}};
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: {{SURFACE}};
    color: {{PRIMARY}};
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: {{BORDER}};
}

/* ===== ACCESSIBILITY: FOCUS RINGS & HIGH-CONTRAST ===== */
/* Visible focus ring for keyboard navigation */
QPushButton:focus,
QToolButton:focus {
    outline: none;
    border: 2px solid {{ACCENT}};
    box-sizing: border-box;
}

QPushButton:focus:pressed {
    border-color: {{PRIMARY_DARK}};
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid {{ACCENT}};
    background-color: {{SURFACE}};
}

QCheckBox:focus,
QRadioButton:focus {
    outline: none;
    border: 2px solid {{ACCENT}};
    border-radius: 3px;
    padding: 2px;
}

/* Make focus highly visible for menu navigation */
#SideMenu QPushButton:focus {
    background-color: rgba(255,255,255,0.12);
    color: {{SURFACE}};
    border-color: {{ACCENT}};
}

/* Increase contrast on selected table rows for readability */
QTableView QTableView::item:selected, QTableWidget::item:selected {
    background-color: {{PRIMARY_LIGHT}};
    color: {{PRIMARY}};
}

/* Ensure focusable elements have minimum target size */
QPushButton, QToolButton {
    min-height: 36px;
    min-width: 36px;
}

/* Reduce animations for users who prefer reduced motion (best-effort) */
/* (Qt doesn't provide a standard prefers-reduced-motion media query in QSS) */
