/* ===== THÈME DESKTOP PRO SOBRE ===== */
QMainWindow {
    background: #eef3f9;
}

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    color: #0f172a;
}

QLabel {
    color: #334155;
    font-size: 13px;
}

/* ===== HEADER ===== */
#Header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ffffff, stop:1 #f8fbff);
    border-bottom: 1px solid #dfe7f1;
}

#LogoContainer {
    background: transparent;
}

#LogoText {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;
}

#PageTitle {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    padding: 4px 8px;
}

#UserInfo {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    padding: 0 10px;
}

#LogoutButton {
    background: #e2e8f0;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
}

#LogoutButton:hover {
    background: #dfe7f1;
}

#LogoutButton:pressed {
    background: #cbd5e1;
}

/* ===== MENU LATÉRAL ===== */
#SideMenu {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1f2d3d, stop:1 #142437);
    border-right: 1px solid #24364d;
}

#ToggleMenu {
    background: rgba(255, 255, 255, 0.05);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    font-size: 18px;
    font-weight: 700;
}

#ToggleMenu:hover {
    background: rgba(255, 255, 255, 0.10);
}

#SideMenu QPushButton {
    background: transparent;
    color: #e2e8f0;
    border: 1px solid transparent;
    border-radius: 10px;
    text-align: left;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 600;
}

#SideMenu QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(148, 163, 184, 0.25);
}

#SideMenu QPushButton:pressed {
    background: rgba(255, 255, 255, 0.12);
}

#SideMenu QPushButton:checked,
#SideMenu QPushButton[selected="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2b4a73, stop:1 #1f3b5f);
    color: #ffffff;
    border: 1px solid rgba(147, 197, 253, 0.45);
}

/* ===== CONTENU PRINCIPAL ===== */
QStackedWidget {
    background: #f6f9fc;
    border-left: 1px solid #dfe7f1;
}

/* ===== BOUTONS GÉNÉRAUX ===== */
QPushButton {
    font-size: 13px;
    font-weight: 600;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton:disabled {
    background: #e2e8f0;
    color: #94a3b8;
    border-color: #cbd5e1;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    border: none;
    background: #edf2f7;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #edf2f7;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

/* ===== CHAMPS DE SAISIE ===== */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 10px;
    background: #ffffff;
    color: #0f172a;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border-color: #5b8def;
    background: #ffffff;
}

/* ===== TABLES ===== */
QTableView, QTableWidget {
    border: 1px solid #dfe7f1;
    border-radius: 12px;
    background: #ffffff;
    alternate-background-color: #f8fafc;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
    gridline-color: #e2e8f0;
}

QHeaderView::section {
    background: #f1f5f9;
    color: #334155;
    font-weight: 700;
    padding: 10px 8px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
}

QTableWidget::item {
    padding: 8px 6px;
    color: #0f172a;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    border: 1px solid #dfe7f1;
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 14px;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px;
    color: #334155;
}

/* ===== CHECKBOX / RADIO ===== */
QCheckBox, QRadioButton {
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border: 2px solid #2563eb;
    border-radius: 4px;
}

QRadioButton::indicator:checked {
    background: #2563eb;
    border: 2px solid #2563eb;
    border-radius: 8px;
}

QProgressBar {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #f1f5f9;
    color: #334155;
    text-align: center;
}

QProgressBar::chunk {
    background: #2563eb;
    border-radius: 5px;
}

QListWidget {
    border: 1px solid #dfe7f1;
    border-radius: 10px;
    background: white;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f1f5f9;
}

QListWidget::item:selected {
    background: #dbeafe;
    color: #0f172a;
}

/* ===== ONGLETS ===== */
QTabWidget::pane {
    border: 1px solid #dfe7f1;
    border-radius: 12px;
    background: #ffffff;
}

QTabBar::tab {
    background: #edf2f7;
    color: #475569;
    padding: 9px 16px;
    margin-right: 2px;
    border: 1px solid #dfe7f1;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0f172a;
    border-bottom: 2px solid #2563eb;
}

QTabBar::tab:hover {
    background: #e2e8f0;
}