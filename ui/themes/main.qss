/* ===== THÈME BLEU MARINE ===== */
QMainWindow {
    background-color: #f8fafc;
}

/* ===== HEADER ===== */
#Header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

#Logo {
    font-size: 24px;
    font-weight: 800;
    color: #2F4255;
    padding: 5px;
}

#PageTitle {
    font-size: 18px;
    font-weight: 600;
    color: #1e293b;
    padding: 5px 10px;
}

#UserInfo {
    font-size: 14px;
    color: #475569;
    padding: 5px 10px;
}

#LogoutButton {
    background-color: #dbeafe;
    color: #2F4255;
    border: 1px solid #2F4255;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 14px;
}

#LogoutButton:hover {
    background-color: #bfdbfe;
    border-color: #2F4255;
}

#LogoutButton:pressed {
    background-color: #2F4255;
}

/* ===== MENU LATÉRAL ===== */
#SideMenu {
    background-color: #2F4255;
    border-right: 1px solid #2F4255;
}

#ToggleMenu {
    background-color: transparent;
    color: white;
    border: 1px solid #2F4255;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
}

#ToggleMenu:hover {
    background-color: #2F4255;
}

#ToggleMenu:pressed {
    background-color: #1B3A7A;
}

/* Boutons du menu (état normal) */
#SideMenu QPushButton {
    background-color: transparent;
    color: #dbeafe;
    border: 1px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 12px;
    font-size: 14px;
    font-weight: 500;
}

#SideMenu QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    border-color: #3A6B9F;
}

#SideMenu QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

#SideMenu QPushButton:checked {
    background-color: #1B3A7A;
    color: white;
    border-color: #3A6B9F;
}

/* Boutons spécifiques */
#btn_dashboard, #btn_sale, #btn_stock, #btn_admin {
    background-color: transparent;
}

/* ===== CONTENU PRINCIPAL ===== */
QStackedWidget {
    background-color: #ffffff;
    border-left: 1px solid #e2e8f0;
}

/* ===== WIDGETS GÉNÉRAUX ===== */
QWidget {
    font-family: 'Segoe UI', 'Arial', sans-serif;
}

QLabel {
    color: #1e293b;
    font-size: 14px;
}

QPushButton {
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton:disabled {
    background-color: #e2e8f0;
    color: #94a3b8;
    border-color: #cbd5e1;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    border: none;
    background-color: #f1f5f9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f1f5f9;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

/* ===== BORDURES ET SÉPARATEURS ===== */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 8px;
    background-color: white;
    selection-background-color: #2F4255;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #2F4255;
    outline: none;
}

/* ===== TABLES ===== */
QTableView, QTableWidget {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background-color: white;
    alternate-background-color: #f8fafc;
    selection-background-color: #dbeafe;
    selection-color: #2F4255;
    gridline-color: #e2e8f0;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: 600;
    padding: 10px;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: 600;
    color: #2F4255;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 10px;
}

/* ===== CHECKBOX & RADIO BUTTON ===== */
QCheckBox, QRadioButton {
    color: #1e293b;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked {
    background-color: #2F4255;
    border: 2px solid #2F4255;
    border-radius: 3px;
}

QRadioButton::indicator:checked {
    background-color: #2F4255;
    border: 2px solid #2F4255;
    border-radius: 8px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    background-color: #f1f5f9;
    text-align: center;
    color: #475569;
}

QProgressBar::chunk {
    background-color: #2F4255;
    border-radius: 3px;
}

/* ===== LISTES ===== */
QListWidget {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background-color: white;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f1f5f9;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #2F4255;
}

/* ===== ONGLETS ===== */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background-color: white;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #475569;
    padding: 8px 16px;
    margin-right: 2px;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: white;
    color: #2F4255;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #e2e8f0;
}