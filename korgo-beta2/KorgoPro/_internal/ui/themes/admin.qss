/* admin_styles.qss - Thème Bleu Marine */

/* ===== FENÊTRE PRINCIPALE ===== */
QWidget {
    background-color: #ecf0f1;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 13px;
}

QWidget#AdminView {
    background-color: #ecf0f1;
}



/* ===== ONGLETS ===== */
QTabWidget#tabWidget {
    background-color: transparent;
    border: none;
}

QTabWidget::pane {
    border: 1px solid #bdc3c7;
    border-radius: 6px;
    background-color: #ffffff;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #ecf0f1;
    color: #7f8c8d;
    padding: 5px 10px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2F4255;
    border: 1px solid #bdc3c7;
    border-bottom: 2px solid #2F4255;
}

QTabBar::tab:hover {
    background-color: #d5dbdb;
    color: #1a252f;
}

/* ===== BARRE D'OUTILS ===== */
QFrame#toolbarFrame {
    background-color: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    padding: 10px;
}

QLineEdit#searchInput {
    padding: 8px 12px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    background-color: #ffffff;
    color: #2c3e50;
}

QLineEdit#searchInput:focus {
    border: 2px solid #2F4255;
    padding: 7px 11px;
}

QPushButton#addButton {
    background-color: #2F4255;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton#addButton:hover {
    background-color: #2F4255;
}

QPushButton#addButton:pressed {
    background-color: #2F4255;
}

QPushButton#exportButton, 
QPushButton#refreshButton {
    background-color: #ecf0f1;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 8px 16px;
}

QPushButton#exportButton:hover,
QPushButton#refreshButton:hover {
    background-color: #d5dbdb;
}

/* ===== TABLEAUX ===== */
QTableWidget#usersTable,
QTableWidget#activityTable {
    background-color: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    alternate-background-color: #f8f9fa;
    selection-background-color: rgba(47, 66, 85, 0.2);
    selection-color: #2F4255;
    gridline-color: #dfe6e9;
}

QTableWidget#usersTable::item,
QTableWidget#activityTable::item {
    padding: 8px;
}

/* EN-TÊTE DU TABLEAU */
QTableWidget#usersTable QHeaderView::section,
QTableWidget#activityTable QHeaderView::section {
    background-color: #2F4255;
    color: white;
    padding: 10px;
    border: none;
    font-weight: bold;
    border-right: 1px solid #2F4255;
}

QTableWidget#usersTable QHeaderView::section:last-child,
QTableWidget#activityTable QHeaderView::section:last-child {
    border-right: none;
}

/* ===== STATISTIQUES ===== */
QFrame#statsFrame {
    background-color: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    padding: 10px;
}

QLabel#statItem {
    padding: 8px 12px;
    background-color: #f8f9fa;
    border-radius: 4px;
    border: 1px solid #e9ecef;
    color: #2c3e50;
    font-weight: 600;
}

QLabel#statItem:hover {
    background-color: #e9ecef;
}

/* ===== GROUPES DE RÔLES ===== */
QGroupBox#roleGroup {
    font-weight: bold;
    font-size: 14px;
    color: #2c3e50;
    border: 2px solid #2F4255;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 20px;
}

QGroupBox#roleGroup::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 10px;
    background-color: #2F4255;
    color: white;
    border-radius: 4px;
}

QLabel#roleDesc {
    color: #7f8c8d;
    font-style: italic;
    padding: 5px 0 15px 0;
    border-bottom: 1px dashed #bdc3c7;
    margin-bottom: 10px;
}

/* ===== PERMISSIONS ===== */
QCheckBox {
    spacing: 8px;
    padding: 6px 0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #bdc3c7;
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:checked {
    border: 2px solid #2F4255;
    border-radius: 3px;
    background-color: #2F4255;
    image: url(:/icons/check.svg);
}

/* ===== BOUTONS D'ACTION DANS LE TABLEAU ===== */
QPushButton#editButton,
QPushButton#toggleButton,
QPushButton#resetButton,
QPushButton#permsButton,
QPushButton#deleteButton {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 5px;
    margin: 0;
}

QPushButton#editButton:hover,
QPushButton#toggleButton:hover,
QPushButton#resetButton:hover,
QPushButton#permsButton:hover,
QPushButton#deleteButton:hover {
    background-color: transparent;
}

QPushButton#editButton:pressed,
QPushButton#toggleButton:pressed,
QPushButton#resetButton:pressed,
QPushButton#permsButton:pressed,
QPushButton#deleteButton:pressed {
    background-color: transparent;
}

/* ===== BOUTONS GÉNÉRAUX ===== */
QPushButton#saveButton {
    background-color: #2F4255;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    min-width: 120px;
}

QPushButton#saveButton:hover {
    background-color: #2F4255;
}

QPushButton#cancelButton {
    background-color: #95a5a6;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    min-width: 120px;
}

QPushButton#cancelButton:hover {
    background-color: #7f8c8d;
}

/* ===== DIALOGUES ===== */
QDialog {
    background-color: #ffffff;
    border: 1px solid #dfe6e9;
    border-radius: 8px;
}

QLabel#descriptionLabel {
    color: #7f8c8d;
    font-size: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #dfe6e9;
}

QLabel#validationInfo {
    color: #f39c12;
    font-style: italic;
    padding: 10px;
    background-color: rgba(243, 156, 18, 0.1);
    border-radius: 4px;
    border-left: 3px solid #f39c12;
}

QLabel#roleDescLabel {
    color: #7f8c8d;
    padding: 8px;
    background-color: #f8f9fa;
    border-radius: 4px;
    border: 1px dashed #bdc3c7;
    font-size: 12px;
    margin-bottom: 15px;
}

/* ===== PERMISSIONS DIALOG ===== */
QLabel#userInfo {
    font-size: 16px;
    color: #2c3e50;
}

QLabel#roleLabel {
    background-color: #2F4255;
    color: white;
    padding: 6px 12px;
    border-radius: 15px;
    font-weight: bold;
}

QFrame#permissionsFrame {
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    padding: 15px;
    background-color: #f8f9fa;
}

QLabel#permsTitle {
    color: #2c3e50;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 10px;
    border-bottom: 2px solid #2F4255;
}

QLabel#statsLabel {
    color: #2c3e50;
    font-size: 14px;
    padding: 12px;
    background-color: white;
    border-radius: 4px;
    border: 1px solid #dfe6e9;
    margin-top: 10px;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    border: none;
    background-color: #f8f9fa;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f8f9fa;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #bdc3c7;
    border-radius: 5px;
    min-width: 30px;
}

/* ===== COMBO BOX ===== */
QComboBox {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 8px;
    background-color: white;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #2F4255;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #bdc3c7;
    background-color: white;
    selection-background-color: #2F4255;
    selection-color: white;
    border-radius: 4px;
}

/* ===== DATE EDIT ===== */
QDateEdit {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 8px;
    background-color: white;
}

QDateEdit:hover {
    border-color: #2F4255;
}

QDateEdit::drop-down {
    border: none;
    width: 30px;
}

/* ===== ICÔNES ===== */
QLabel {
    qproperty-alignment: 'AlignVCenter | AlignLeft';
}

/* ===== ÉTATS SPÉCIAUX ===== */
QTableWidget#usersTable::item:selected {
    background-color: rgba(13, 31, 74, 0.1);
    color: #061433;
    font-weight: bold;
}

QCheckBox[checked="true"] {
    color: #2F4255;
    font-weight: bold;
}

/* ===== TOOLTIPS ===== */
QToolTip {
    background-color: #2F4255;
    color: white;
    border: 1px solid #2F4255;
    border-radius: 4px;
    padding: 8px;
    font-size: 12px;
}

/* ===== SÉPARATEURS ===== */
QFrame[frameShape="4"] { /* HLine */
    color: #dfe6e9;
}

QFrame[frameShape="5"] { /* VLine */
    color: #dfe6e9;
}

/* ===== BOUTONS RONDS ===== */
QToolButton {
    border-radius: 50%;
    background-color: #2F4255;
    color: white;
}

QToolButton:hover {
    background-color: #2F4255;
}
